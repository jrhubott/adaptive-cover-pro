#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# shellcheck source=scripts/_venv.sh
source scripts/_venv.sh
activate_venv || true

for tool in ruff black; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "$tool not found. Run ./scripts/setup, or activate a venv that has it." >&2
        exit 1
    fi
done

ruff check . --fix
black .
